# luroConnect Magento 2 -- the .gitignore entries the build pipeline requires.
# Merge these into your existing .gitignore; do not blindly replace yours.

# Generated by the build. Committing these breaks or slows the pipeline.
/vendor/
/generated/
/var/
/pub/static/*
!/pub/static/.htaccess

# Shared on the server, symlinked into each release.
/pub/media/

# Injected at deploy time, or written at build time from credentials luroConnect
# holds. These contain secrets and must never be committed.
/app/etc/env.php
/auth.json
/id_rsa
/.env

# Local tooling
/.idea/
/.vscode/
/nbproject/
.DS_Store

# ---------------------------------------------------------------------------
# DELIBERATELY NOT IGNORED:
#
#   app/etc/config.php         the module list -- MUST be tracked
#   config.php.build           themes, scopes, build-time system config -- tracked
#                              ONLY if your project owns it. luroConnect commonly
#                              maintains it on the server instead, in which case it
#                              is correctly absent from git. Don't add ignore rules
#                              for it either way.
#
# Several public Magento .gitignore templates ignore app/etc/config.php. On
# luroConnect that breaks the build -- the module list would be empty.
#
# Check yours with:  git check-ignore -v app/etc/config.php
# (it should print nothing)
# ---------------------------------------------------------------------------
